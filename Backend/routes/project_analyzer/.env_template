# Copy this to your .env file and fill in the values

# Google Gemini API (Optional - for cloud-based analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=auto

# LM Studio Configuration (Local AI - Required for local analysis)
LOCAL_LLM_URL=http://localhost:1234
MODEL_NAME=qwen2.5-coder-3b-instruct

# Analysis Parameters
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=3000
LOCAL_MODEL_MAX_TOKENS=1000
LOCAL_PROMPT_CHAR_BUDGET=3800
CHUNK_CHAR_BUDGET=2200
MAX_REVIEW_CHUNKS=20
